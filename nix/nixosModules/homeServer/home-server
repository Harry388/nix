#!/usr/bin/env bash

if [ -z "$SERVICES_LOCATION" ]; then
    SERVICES_LOCATION="$HOME/services"
fi

if [ -z "$RCLONE_REMOTE" ]; then
    RCLONE_REMOTE="backup"
fi

find-services () {
    target="$SERVICES_LOCATION"
    find "$target" -mindepth 1 -maxdepth 1 -type d
}

start-service () {
    service="$1"
    home="$SERVICES_LOCATION/$service"
    if ! [ -d "$home" ]; then
        echo "No such service: $service"
        return 1
    fi
    echo "Starting $service..."
    if [ -d "$home" ]; then
        pushd "$home" || return 1
        if [ -f "docker-compose.yml" ]; then
            docker compose up -d
        else # assume systemd
            systemctl start "$service.service"
        fi
        popd || return 1
    fi
}

stop-service () {
    service="$1"
    home="$SERVICES_LOCATION/$service"
    if ! [ -d "$home" ]; then
        echo "No such service: $service"
        return 1
    fi
    echo "Stopping $service..."
    if [ -d "$home" ]; then
        pushd "$home" || return 1
        if [ -f "docker-compose.yml" ]; then
            docker compose stop
        else # assume systemd
            systemctl stop "$service.service"
        fi
        popd || return 1
    fi
}

backup-service () {
    service="$1"
    home="$SERVICES_LOCATION/$service"
    if ! [ -d "$home" ]; then
        echo "No such service: $service"
        return 1
    fi
    echo "Backing up $service..."
    # today="$(date +%Y-%m-%d)"
    # rclone sync "$home" "$RCLONE_REMOTE:$service" --backup-dir "$RCLONE_REMOTE:$service-old/$today" --metadata
    rclone sync "$home" "$RCLONE_REMOTE:$service" --metadata
}

restore-service () {
    service="$1"
    home="$SERVICES_LOCATION/$service"
    if [ -d "$home" ]; then
        echo "Removing existing $service..."
        rm -rf "$home"
    fi
    mkdir -p "$home"
    echo "Restoring $service..."
    rclone copy "$RCLONE_REMOTE:$service" "$home" --metadata
}

